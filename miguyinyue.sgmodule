#!name=咪咕音乐去广告(模拟空响应版)
#!desc=通过返回空 JSON 骗过咪咕 App 跳过开屏广告

[Rule]
# 拦截纯广告 SDK 与埋点
DOMAIN, app.log.nf.migu.cn, REJECT
DOMAIN, uem.migu.cn, REJECT
DOMAIN-SUFFIX, ad.miguvideo.com, REJECT
DOMAIN-SUFFIX, ad.migu.cn, REJECT
DOMAIN-SUFFIX, sdk.migu.cn, REJECT
DOMAIN, g.migu.cn, REJECT
DOMAIN, sdkConfig.migu.cn, REJECT

[URL Rewrite]
# 注意：这里改用 reject-dict / reject-200，返回空字典，防止 App 报错后调用本地兜底开屏图
^https?:\/\/.*\.migu\.cn\/.*\/(getStartPage|splash|ad\/).* _ reject-dict
^https?:\/\/music\.migu\.cn\/v3\/api\/ad\/.* _ reject-dict
^https?:\/\/ggx\d+\.miguvideo\.com\/request\/.* _ reject-dict
^https?:\/\/.*\.migu\.cn\/.*\/preload.* _ reject-200

[MITM]
hostname = %APPEND% *.migu.cn, music.migu.cn, ggx*.miguvideo.com
