#!name=咪咕音乐纯去广告
#!desc=精准拦截咪咕音乐开屏广告、弹窗广告及日志追踪 SDK，不影响音乐正常播放与音质。
#!author=Custom
#!category=去广告

[Rule]
# 阻断广告与追踪 SDK 域名
HOST, app.log.nf.migu.cn, REJECT
HOST, uem.migu.cn, REJECT
HOST-SUFFIX, ad.miguvideo.com, REJECT
HOST-SUFFIX, ad.migu.cn, REJECT
HOST-SUFFIX, sdk.migu.cn, REJECT
HOST, g.migu.cn, REJECT
HOST, sdkConfig.migu.cn, REJECT

[URL Rewrite]
# 拦截咪咕音乐开屏与营销广告 API（返回空 JSON 字典/200，秒开无广告）
^https?:\/\/.*\.migu\.cn\/.*\/(getStartPage|splash|ad\/).* reject-dict
^https?:\/\/music\.migu\.cn\/v3\/api\/ad\/.* reject-dict
^https?:\/\/ggx\d+\.miguvideo\.com\/request\/.* reject-dict
^https?:\/\/app\.c\.nf\.migu\.cn\/member\/api\/marketing\/.* reject-dict
^https?:\/\/app\.c\.nf\.migu\.cn\/payment\/watch-ad reject-200
^https?:\/\/.*\.migu\.cn\/.*\/preload.* reject-200

[MITM]
hostname = *.migu.cn, music.migu.cn, ggx*.miguvideo.com
