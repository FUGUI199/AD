name=咪咕音乐去开屏与广告
desc=精准拦截咪咕音乐开屏广告、弹窗及横幅
hostname=*.migu.cn, *.miguvideo.com, ad.migu.cn, sdk.migu.cn

[rewrite_local]
# 开屏广告 API 拦截
^https?:\/\/.*\.migu\.cn\/.*\/(getStartPage|splash|ad).* url reject-200
^https?:\/\/music\.migu\.cn\/v3\/api\/ad\/.* url reject-200

[filter_local]
# 广告域名与 CDN 拦截
domain-suffix, ad.miguvideo.com, reject
domain-suffix, ad.migu.cn, reject
domain-suffix, sdk.migu.cn, reject
domain-suffix, migu-ad.com, reject
domain, g.migu.cn, reject
domain, sdkConfig.migu.cn, reject
