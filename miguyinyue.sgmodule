#!name=咪咕音乐去广告
#!desc=拦截咪咕音乐开屏广告、弹窗及动态Banner

[Rule]
DOMAIN-SUFFIX, ad.miguvideo.com, REJECT
DOMAIN-SUFFIX, ad.migu.cn, REJECT
DOMAIN-SUFFIX, sdk.migu.cn, REJECT
DOMAIN-KEYWORD, migu-ad, REJECT
DOMAIN, g.migu.cn, REJECT
DOMAIN, sdkConfig.migu.cn, REJECT

[URL Rewrite]
^https?:\/\/.*\.migu\.cn\/.*\/(getStartPage|splash|ad).* _ reject
^https?:\/\/music\.migu\.cn\/v3\/api\/ad\/.* _ reject

[MITM]
hostname = %APPEND% *.migu.cn, ad.miguvideo.com
