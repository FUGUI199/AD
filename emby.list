#!name=自用 Emby & 反代分流模块
#!desc=针对各 Emby 线路及通用反代域名的直连与代理分流控制
#!category=分流

[Rule]
# 禁日本IP，禁直连（走代理）
# 宸澄龙
DOMAIN-SUFFIX, dragon.wybcs.work, PROXY
# 帝服
DOMAIN-SUFFIX, di0.uk, PROXY


# 通用反代
DOMAIN-SUFFIX, dpdns.org, DIRECT
DOMAIN-SUFFIX, de5.net, DIRECT
DOMAIN-SUFFIX, bbroot.com, DIRECT

# 非越（禁日本IP）
DOMAIN-SUFFIX, cf.sfcj.org, DIRECT

# okemby反代
DOMAIN-SUFFIX, fd.jzdj.dpdns.org, DIRECT
DOMAIN-SUFFIX, ok.draxy.eu.cc, DIRECT

# 宸澄
DOMAIN-SUFFIX, wybcs.work, DIRECT
DOMAIN-SUFFIX, ccmedia.top, DIRECT

# 茶百道
# DOMAIN-SUFFIX, chapanda.site, DIRECT

# 瞬影
DOMAIN-SUFFIX, syemby.com, DIRECT

# 宸宇
DOMAIN-SUFFIX, dylan.xin, DIRECT


